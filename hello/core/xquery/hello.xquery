# -*- mode: xquery -*-
# XQuery - Hello World! :: RAiNBOW_Hello-World
#   colour     : #5232e7
#   hue        : 250.6 deg
#   layer      : core (byte-balanced rainbow bar)
#   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
