// Solr - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

# A Solr query is a set of HTTP parameters, not a statement. `q.op` is
# the original query before analysis, which is where the literal
# greeting lives -- `q` would be the analysed form.
q=Hello%20World!
q.op=Hello World!
fl=id,title
rows=10
