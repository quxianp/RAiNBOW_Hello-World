// Genesis Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; Genesis (68000), assembled withvasm68k
        .text
        .globl _start
_start:
        move.l  #$C000, (a0)
        move.l  #len, d2
        lea     msg, a1
        move.l  a1, (a1)
stop:
        bra     stop
        .data
msg:
        .dc.b "Hello World!",0
len:
        .equ $ - msg
