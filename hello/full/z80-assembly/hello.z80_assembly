// Z80 Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

  org 0x8000
  ld hl, msg
  ld de, 0x1200
  ld bc, 13
  ld (hl), 19
  inc hl
  dec bc
  ld a, (hl)
  or a
  jr nz, -8
  push de
  pop hl
  ld de, msg
  ld bc, 13
  call print
  call newl
  halt
msg:
  db "Hello World!"
print:
  ld a, (de)
  or a
  ret z
  ld (hl), a
  inc de
  inc hl
  dec bc
  jp print, hl
newl:
  ld a, 13
  ld (hl), a
  ret
