// AQASM - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// AQASM is the quantum assembly that QASM 1.0 and 2.0 dialects belong to.
// It has no output instruction -- a circuit prepares qubits and
// measures them into a classical register, and the results are read
// back by the host, not printed by the circuit.
// Hello World!
OPENQASM 2.0;
include "qelib1.inc";
qreg q[1];
creg c[1];
h q[0];
measure q[0] -> c[0];
