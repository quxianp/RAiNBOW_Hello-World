// MiniKanren - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

;; MiniKanren is a library rather than a language, so its files are
;; Scheme. The two idioms it adds -- `run*` and `--reify` -- are
;; how a query becomes an answer, and there is no print for them.
(import (chezscheme))

(define (main)
  (display "Hello World!")
  (newline))

(main)
