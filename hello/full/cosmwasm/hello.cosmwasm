// CosmWasm - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// CosmWasm contracts are Rust compiled to wasm.
use cosmwasm_std::{entry_point, Deps, Env, Response, StdResult};

#[entry_point]
pub fn greet(_deps: Deps, _env: Env) -> StdResult<Response> {
    Ok(Response::new().add_attribute("greeting", "Hello World!"))
}
