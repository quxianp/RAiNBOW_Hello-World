// Quil-T - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

# Quil-T is another Quil dialect, for a different target.
# Quil has no output operation, so "Hello World!" is carried as a
# declared classical register.
DECLARE greeting BIT[12]
