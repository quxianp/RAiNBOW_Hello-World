// WASM text format - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

;; WebAssembly text format, the source a .wasm is assembled from.
;; A module is types, then imports, then functions, then exports, then
;; code; the order is fixed by the binary format underneath it.
(module
  (func $greet (export "greet") (result i32)
    ;; the greeting as a data segment address
    i32.const 0)
  (data (i32.const 0) "Hello World!"))
