// AVR32 Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; AVR32, the 32-bit AVR. Uses the Application
        ; Programming Interface: a0 holds the buffer,
        ; a1 its length, and sys_write is 64.
        .text
        .global _start
_start:
        push    {r4-r5, lr}
        mov     r4, r0          ; buffer
        mov     r5, r1          ; length
        mov     r7, 64          ; sys_write
        mov     r0, r4
        mov     r1, r5
        mov     r2, r4
        mov     r3, r5
        ldr     r4, =greeting
        mov     r0, r4
        mov     r1, r5
        mov     r2, r4
        mov     r3, r5
        ldr     pc, [r7, -8]
        .data
greeting:
  .asciz "Hello World!"
