// OGC - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

# OGC is a family of geospatial standards. Its service documents are XML,
# and the greeting rides in the abstract element, which is free text.
<?xml version="1.0" encoding="UTF-8"?>
<Service xmlns="http://www.opengis.net/ows">
  <Abstract>Hello World!</Abstract>
</Service>
