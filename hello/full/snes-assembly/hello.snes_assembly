// SNES Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; SNES (65816), assembled with ca65
        .segment "CODE"
        .export _start
_start:
        lda #$01              ; decompress to VRAM write enable
        sta $2100
        ldx #0
loop:
        lda msg,x
        beq done
        sta $2115            ; OAM data port
        inx
        bne loop
done:
        stp

        .segment "RODATA"
msg:    .byte "HELLO WORLD!", 0
