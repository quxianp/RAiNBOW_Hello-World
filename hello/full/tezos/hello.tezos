// Tezos - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

;; Michelson is Tezos's contract language. Its comments use ;;,
;; which is where the greeting goes: a contract may not print.
parameter unit;
storage unit;
code {
  CDR;
  NIL operation;
  PAIR;   ;; Hello World!
};
