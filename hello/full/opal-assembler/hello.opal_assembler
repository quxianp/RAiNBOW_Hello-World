// Opal assembler - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; Opal, the assembler for the Saturn (68HC000)
        .text
        .global _start
_start:
        move.l  #12, %d0
        move.l  #msg, %a0
        move.l  #4, %d1
        move.l  #5, %d2
        trap    #15
        move.l  #5, %d1
        move.l  #0, %d2
        trap    #15

        .data
msg:    .dc.b "Hello World!", %cr, %lf, 0
