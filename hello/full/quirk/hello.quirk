import json

# Quirk is a quantum circuit simulator written in Python, so its Hello
# World is a Python program. A Quirk circuit travels as JSON, which is
# what the share link carries.
print("Hello World!")
print(json.dumps({"name": "Hello World!", "gates": [["H", 0]]}))
