// Sqrl - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

# Sqrl is an RDF query language in the SPARQL family. A Sqrl document
# is a set of statements, so the greeting is a predicate.
PREFIX : <http://example.org/>
:a :greeting "Hello World!" .
