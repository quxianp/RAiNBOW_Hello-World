// Alpha64 - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; Alpha64 is a 6502-based assembler with macros.
        * = $0801
        .word $FFFC
start:
        lda #<msg
        sta ptr
        lda #>msg
        sta ptr+1
        ldy #0
loop:
        lda (ptr),y
        beq done
        jsr $FFD2
        iny
        bne loop
done:
        rts
msg:
        .byte "HELLO WORLD!", 0
