// PL-P - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// PL/P is a PL/I dialect aimed at pattern-directed programming.
// A file is a set of procedures.
declare greet procedure;
greet: procedure;
    write('Hello World!');
end greet;
