// Inferno is Plan 9's successor, and it runs on a real operating
// system -- so unlike the other assembly entries here, this one
// has somewhere to print. That somewhere is write(2).
#include <syscall.h>

void
main(void)
{
    char *m[] = { "Hello World!", 0 };
    write(1, m, 12);
}
