// Huff - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// Huff is a macro language for EVM bytecode. Everything is bytes,
// so there are no strings in it and nothing to print: the program
# is a macro whose value is the greeting "Hello World!" as hex.
//
//   48 65 6C 6C 6F 20 57 6F 72 6C 64 21
#define HELLO 0x48656C6C6F20576F726C6421
#define MAIN() HELLO
