// NXT - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// NXT is the LEGO Mindstorms brick's firmware. There is no console;
// its display is the LCD, so the greeting is written there.
LCD_INIT();
LCD_CLEAR();
LCD_WRITE(0, "Hello World!");
