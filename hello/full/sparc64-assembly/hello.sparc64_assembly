// Sparc64 Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        .section .rodata
msg:    .asciz "Hello World!\n"

        .section .text
        .global _start
_start:
        mov  5, %g1            # buffer
        sethi %hi(msg), %g1
        or   %lo(msg), %g1, %g1
        mov  1, %o0            # write
        mov  1, %o1            # fd
        mov  %g1, %o2
        mov  13, %o3           # length
        mov  8, %g2            # buffer
        mov  %g2, %o4
        mov  0, %o5
        mov  6, %g3
        call %trap
        mov  1, %g1
        mov  91, %o0           # exit
        mov  %g1, %o1
        mov  8, %g2
        mov  %g2, %o4
        mov  0, %o5
        mov  6, %g3
        call %trap
