// Alpha Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; Alpha assembly: a register machine, and its Hello World
        ; is the six instructions that syscall the kernel.
        .text
        .globl _start
_start:
        lda     $60(zero), $0     # syscall number
        lda     msg, $r0
        lda     $12, $r1
        call    trap
        .data
msg:    .asciz "Hello World!"
