# pyquil - Hello World! :: RAiNBOW_Hello-World
#   colour     : not assigned by Linguist
#   layer      : full (byte-balanced rainbow bar)
#   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
#   reference  : see https://esolangs.org/ and https://rosettacode.org/

from pyquil import Program

# pyquil builds Quil programs. This one prepares |0> for the gate, and
# printing the program object is how you read its Quil back.
program = Program("H 0")
print("Hello World!", program.out())
