//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// Thunkable is an App Inventor variant, so its project is a
// JSON document and the component tree is the program.
{
  "name": "Hello World!",
  "components": [{ "type": "Label", "Text": "Hello World!" }]
}
