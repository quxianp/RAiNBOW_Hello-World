// NetCDF - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// The CDL text form of a netCDF file. netCDF proper is a binary
// container; CDL is the human-readable version of the same thing.
netcdf hello {
  dimensions:
    greeting = 1 ;
  variables:
    string greeting(greeting) ;
  data:
    greeting = "Hello World!" ;
}
