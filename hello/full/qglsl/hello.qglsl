// qGLSL - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// A GLSL shader draws rather than prints, so the greeting is the
// colour the fragment shader writes.
void main() {
    gl_FragColor = vec4(1.0, 1.0, 1.0, 1.0);  // Hello World!
}
