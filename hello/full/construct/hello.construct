// Construct - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// Construct is a game engine with an event sheet rather than a
// script, so its Hello World is a sheet with one event.
{
  "name": "Hello World!",
  "events": [{ "event": "run", "action": "log \"Hello World!\"" }]
}
