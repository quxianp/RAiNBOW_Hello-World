// NuSMV - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// NuSMV is a model checker. It has no output statement; what it
// has is an invariant that must hold, and the greeting is the name.
MODULE main
VAR
  greeting : boolean;
INIT
  greeting := TRUE;
INVARSPEC
  name = Hello World!
