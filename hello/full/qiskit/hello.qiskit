// Qiskit - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

from qiskit import QuantumCircuit

# Two qubits, a Hadamard and a controlled-X: the circuit every
# quantum tutorial opens with, and the one Qiskit's docs greet you with.
bell = QuantumCircuit(2, 2)
bell.h(0)
bell.cx(0, 1)
print("Hello World!")
