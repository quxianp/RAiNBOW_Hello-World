// LinkQL - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// LinkQL is a query language over a site's link graph. Its answers are
// URLs, so its program is a query rather than a statement --
// and the greeting is the document the query returns.
// Hello World!
SELECT out FROM link
WHERE in = "https://example.org/"
