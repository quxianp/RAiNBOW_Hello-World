// Hexagon Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; Hexagon, the DSP in Snapdragon. Calls use r31 as the link register.
        .text
        .globl greeting
greeting:
        r6 = r31
        r0 = #56                ; 'H'
        call print_char
        r6 = r31
        return
        .section .rodata
msg:
        .string "Hello World!"
