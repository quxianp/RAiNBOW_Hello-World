// Fig - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// Fig completion specs are TypeScript files. A spec's `description` is the
// one free-text field a spec has, so the greeting goes there.
const completionSpec: Fig.Spec = {
  name: "hello",
  description: "Hello World!",
  args: { name: "world", isOptional: true },
};

export default completionSpec;
