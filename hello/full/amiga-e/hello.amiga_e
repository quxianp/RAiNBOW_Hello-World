// Amiga E - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; Amiga E, the Motorola assembly dialect.
        .text
        .globl _main
_main:
        move.l  #4,d0
        pea     msg
        move.l  d0,d1
        move.l  #12,d2
        jsr     -30(a6)        ; Write
        moveq   #0,d0
        rts
        .data
msg:    dc.b "Hello World!",0
