// RoboCode is the Java-based robot simulator every introductory
// robotics course starts with. A battle file implements
// AdvancedRobot, and run() is called once per tick.
import robocode.*;

public class MyFirstRobot extends AdvancedRobot {
    public void run() {
        out.println("Hello World!");
    }
}
