// QVM - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

;; QVM is the TON virtual machine, written in FunC assembly.
;; A contract entry point is `main`; it returns nothing.
(int main() impure {
    ;; the return value carries "Hello World!" to the caller
    return 0;
})
