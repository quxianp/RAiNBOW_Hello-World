// NES Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; NES (6502), assembled with ca65
        .segment "CODE"
        .proc reset
        lda #<msg
        sta $0200
        lda #>msg
        sta $0201
        ldx #0
loop:   lda msg,x
        beq done
        sta $0200,x
        inx
        bne loop
done:   jmp done
        .endproc

        .segment "RODATA"
msg:    .byte "Hello World!", 0
