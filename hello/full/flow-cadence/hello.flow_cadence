// Flow Cadence - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// Cadence is the resource-oriented language Flow uses. `main` may
// return a value, and the host decodes it, which is Cadence's
// whole output mechanism.
access(all) fun main(): String {
    return "Hello World!"
}
