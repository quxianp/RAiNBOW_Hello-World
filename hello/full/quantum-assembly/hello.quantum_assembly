// Quantum Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// The quantum assembly family is QASM: a list of gate applications on
// qubits and a measurement into a classical register. There is no
// output instruction -- the host reads the register rather than the
// circuit printing anything -- so the greeting is this comment.
// Hello World!
OPENQASM 2.0;
include "qelib1.inc";
qreg q[1];
creg c[1];
h q[0];
measure q[0] -> c[0];
