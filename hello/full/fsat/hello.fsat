// FSAT - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// FSAT is a finite-state automaton toolbox; a program is a
// transition system with a start state and an accepting one.
state: start {
  next: accept;
}
state: accept {
  output: "Hello World!";
}
