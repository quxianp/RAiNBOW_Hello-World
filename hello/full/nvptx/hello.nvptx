// NVPTX - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// NVPTX is NVIDIA's PTX with the vendor's register names and its
// intrinsic set. Like PTX it has no output instruction: the
// device writes memory and the host reads it back.
// Hello World!
.version 6.4
.target sm_52
.address_size 64

.visible .entry hello_world()
{
    ret;
}
