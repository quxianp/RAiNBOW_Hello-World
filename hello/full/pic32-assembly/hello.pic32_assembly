// PIC32 Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; Microchip PIC32, which is a MIPS core with peripheral aliases.
        #include <p32xxxx.h>

        .section .text
        .global main
main:
        la      $t0, greeting
        jal     print_string
        .set    noreorder
        .end

        .section .rodata
greeting:
        .asciz  "Hello World!"
