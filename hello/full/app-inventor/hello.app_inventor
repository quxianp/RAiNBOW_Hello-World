// App Inventor - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// An App Inventor project is a .aia, which is JSON. The label
// text is the greeting, which is what the app displays.
{
  "componentName": "Hello World!",
  "properties": { "Text": "Hello World!" }
}
