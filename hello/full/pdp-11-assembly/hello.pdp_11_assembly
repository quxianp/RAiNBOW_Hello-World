// PDP-11 Assembly - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

        ; PDP-11, one of the machines that had this before 1978
        .text
        .globl _start
_start: mov     $6, -(sp)       /* char */
        mov     msg, -(sp)      /* &string */
        mov     $1, -(sp)       /* stdout */
        jsr     printf, .        /* the classic example */
        mov     $0, -(sp)
        mov     $0, -(sp)       /* exit status */
        mov     $0, -(sp)       /* exit */
        jsr     exit, .

        .data
msg:    <Hello World!\n\0>
