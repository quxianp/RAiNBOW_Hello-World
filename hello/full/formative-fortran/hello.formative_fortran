// Formative Fortran - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// Pre-1966 Fortran is fixed form with Hollerith literals, which is
// exactly where a greeting belongs in a program that cannot
// read from a terminal.
      PROGRAM HELLO
      DATA A/13HHello World!/
      WRITE (6,20) A
 20   FORMAT (1X,A13)
      STOP
      END
