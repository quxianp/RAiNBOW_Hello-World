// PennyLane - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

import pennylane as qml

dev = qml.device("default.qubit", wires=1)


@qml.qnode(dev)
def circuit():
    # Expval of X on |0>: the one circuit every PennyLane tutorial
    # starts with, and the value this returns.
    return qml.expval(qml.PauliX(0))


print("Hello World!", circuit())
