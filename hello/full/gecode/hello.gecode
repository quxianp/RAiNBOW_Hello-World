// Gecode - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// Gecode is a constraint solver library; MiniZinc is its modelling
// language, and a MiniZinc program must end in an output statement.
include "gecode.mzn";

predicate greet() = true;

solve satisfy;

output ["Hello World!\n"];
