// GeoParquet - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

# GeoParquet stores its schema as Parquet key-value metadata in the file
# footer, so a .geojson sidecar is the documented alternative for a
# example. The greeting is the dataset title.
{
  "type": "FeatureCollection",
  "name": "Hello World!",
  "features": []
}
