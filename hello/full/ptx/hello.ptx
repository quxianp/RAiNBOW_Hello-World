// PTX - Hello World! :: RAiNBOW_Hello-World
//   colour     : not assigned by Linguist
//   layer      : full (byte-balanced rainbow bar)
//   upstream   : https://github.com/quxianp/RAiNBOW_Hello-World
//   reference  : see https://esolangs.org/ and https://rosettacode.org/

// PTX is the virtual instruction set a GPU compiler emits. There is no
// output instruction anywhere in it: a kernel writes to memory and
// the host reads the buffer back afterwards.
// Hello World!
.version 7.0
.target sm_50
.address_size 64

.visible .entry hello_world()
{
    ret;
}
