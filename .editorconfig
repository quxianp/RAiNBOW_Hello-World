# EditorConfig, because .gitattributes already pins the line endings.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Generated language stubs are byte-padded to an exact size: trailing
# whitespace is load-bearing there and must never be trimmed.
[hello/core/**]
trim_trailing_whitespace = false
insert_final_newline = false

[hello/full/**]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{sh,bash,tape}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab